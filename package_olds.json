{
  "config": {
    "vendoredhb": "_vendor/github.com/nolimits4web/Swiper"
  },
  "name": "gallery-glide",
  "version": "0.0.1",
  "description": "gallery carousel as a Hugo Module",
  "private": true,
  "main": "",
  "scripts": {
    "build:vendor_install": "hugo mod vendor && npm install --ignore-scripts --prefix $npm_package_config_vendoredhb",
    "build:dist": "rsync -a $npm_package_config_vendoredhb/dist/*.css $npm_package_config_vendoredhb/dist/*.mjs $npm_package_config_vendoredhb/dist/modules $npm_package_config_vendoredhb/dist/shared ./assets/gal/.",
    "build": "npm run build:vendor_install && npm --prefix $npm_package_config_vendoredhb run build:prod && npm run build:dist"
  },
  "keywords": [],
  "author": "tnarik <tnarik@lecafeautomatique.co.uk>",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.2"
  }
}
